{
  "name": "Cyberix",
  "private": true,
  "version": "1.0.0",
  "main": "public/electron.cjs",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "powershell -ExecutionPolicy Bypass -File clean-release.ps1",
    "build:exe": "npm run clean && npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "maldef:run": "node -e \"require('./src/maldef/orchestrator').runMaldefScan(process.argv[1]||'https://example.com',{onProgress:u=>console.log(JSON.stringify(u))}).then(r=>console.log(JSON.stringify(r))).catch(e=>console.error(e))\" https://example.com",
    "test": "echo \"No tests yet (Jest placeholder)\" && exit 0",
    "start": "electron ."
  },

  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.0",
    "dotenv": "^16.3.1",
    "execa": "^9.6.0",
    "framer-motion": "^12.23.22",
    "html2canvas": "^1.4.1",
    "inquirer": "^12.10.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.544.0",
    "ora": "^9.0.0",
    "puppeteer": "^22.0.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.2.1",
    "tailwindcss": "^4.1.13",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },

  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  },

  "build": {
    "appId": "com.cyberix.app",
    "productName": "Cyberix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "src/main/**/*",
      "src/utils/**/*",
      "src/setup/**/*",
      "src/maldef/**/*",
      "src/scanners/**/*",
      "src/tools/**/*",
      "backend/**/*",
      "package.json",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/*.md",
      "!**/*.log",
      "!.git/**/*",
      "!.vscode/**/*",
      "!.idea/**/*"
    ],

    "extraFiles": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],

    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "src/assets/Cybersecurity research-02.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cyberix",
      "installerIcon": "src/assets/Cybersecurity research-02.ico",
      "uninstallerIcon": "src/assets/Cybersecurity research-02.ico",
      "installerHeaderIcon": "src/assets/Cybersecurity research-02.ico",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "warningsAsErrors": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },

    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
